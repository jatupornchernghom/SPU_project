# MongoDB Atlas (or local MongoDB) connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/spu-skipq

# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# Base URL of the app (used by Auth.js)
NEXTAUTH_URL=http://localhost:3000

# Note: PromptPay QR payment no longer uses an env var — each restaurant has
# its own PromptPay ID, set via Admin > ร้านอาหาร > แก้ไข (or the seed script).
# See docs/promptpay-qr.md
